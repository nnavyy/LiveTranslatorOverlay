<Window x:Class="LiveTranslatorOverlay.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report Bug &amp; Feedback" Width="460" Height="530"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#18181B" Foreground="White"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#2E2E33"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#007ACC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0098FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="TxtTitle" Text="Report Bug &amp; Feedback" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="TxtSubtitle" Text="Send bug reports, suggestions, or feedback to developer" FontSize="11" Foreground="#888888" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Form Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="LblType" Text="Report Type:" Foreground="#BBBBBB" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbType" SelectedIndex="0" Margin="0,0,0,10" Padding="5">
                        <ComboBoxItem x:Name="ItemTypeBug" Content="Bug Report" Tag="Bug Report"/>
                        <ComboBoxItem x:Name="ItemTypeFeature" Content="Feature Suggestion" Tag="Feature Suggestion"/>
                        <ComboBoxItem x:Name="ItemTypeGeneral" Content="General Feedback" Tag="General Feedback"/>
                    </ComboBox>

                    <TextBlock x:Name="LblContact" Text="Your Email (Optional):" Foreground="#BBBBBB" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtContact" Background="#26262A" Foreground="White" BorderBrush="#3F3F46" Padding="6,5" Margin="0,0,0,10"/>

                    <TextBlock x:Name="LblSubject" Text="Subject:" Foreground="#BBBBBB" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSubject" Background="#26262A" Foreground="White" BorderBrush="#3F3F46" Padding="6,5" Margin="0,0,0,10"/>

                    <TextBlock x:Name="LblMessage" Text="Description / Details:" Foreground="#BBBBBB" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtMessage" Background="#26262A" Foreground="White" BorderBrush="#3F3F46" Padding="6,5" 
                             AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Status Text -->
            <TextBlock x:Name="TxtStatus" Grid.Row="2" Text="" Foreground="#10B981" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>

            <!-- Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnMailto" Grid.Column="0" Content="Open Email App" Style="{StaticResource ModernButton}" Click="BtnMailto_Click" Padding="12,6"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnClose" Content="Cancel" Style="{StaticResource ModernButton}" Click="BtnClose_Click" Margin="0,0,8,0" Padding="14,6"/>
                    <Button x:Name="BtnSend" Content="Send Report" Style="{StaticResource PrimaryButton}" Click="BtnSend_Click" Padding="16,6"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
