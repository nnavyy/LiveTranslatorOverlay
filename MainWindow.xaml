<Window x:Class="LiveTranslatorOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Translator Overlay"
        WindowState="Maximized" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="{x:Null}" 
        Topmost="True" 
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#222222"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ActionPrimaryButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#007ACC"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0098FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="ActionDangerButton" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#CC2222"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="FadeInCaption">
            <DoubleAnimation Storyboard.TargetName="CaptionBar" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="FadeOutCaption">
            <DoubleAnimation Storyboard.TargetName="CaptionBar" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>

    <Canvas x:Name="OverlayCanvas" Background="{x:Null}" 
            MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
            MouseMove="OverlayCanvas_MouseMove"
            MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
        
        <!-- Selection Rectangle -->
        <Rectangle x:Name="SelectionRect" Stroke="#00FF88" StrokeThickness="2" StrokeDashArray="2,2" Fill="#2000FF88" Visibility="Collapsed"/>
        
        <!-- Translated Text Box (OCR) -->
        <Border x:Name="TranslatedTextContainer" MaxWidth="800" MaxHeight="600" Background="#CC0A0A0A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Visibility="Collapsed" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TranslatedTextBlock" Foreground="#E0E0E0" FontSize="16" FontFamily="Segoe UI" TextWrapping="Wrap" Text="[Terjemahan akan muncul di sini]"/>
            </ScrollViewer>
        </Border>

        <!-- Audio Caption Bar (bottom center) -->
        <Border x:Name="CaptionBar" Background="#B3000000" CornerRadius="12" Padding="20,12" Visibility="Collapsed" MinWidth="400" MaxWidth="900" Opacity="0">
            <StackPanel>
                <TextBlock x:Name="CaptionOriginal" Foreground="#999999" FontFamily="Segoe UI" FontSize="14" TextWrapping="Wrap" Text="" Margin="0,0,0,2"/>
                <TextBlock x:Name="CaptionTranslated" Foreground="#00FF88" FontFamily="Segoe UI Semibold" FontSize="20" TextWrapping="Wrap" Text="[Menunggu audio...]">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Control Panel Container -->
        <StackPanel x:Name="ControlPanelContainer" Canvas.Left="20" Canvas.Top="20">
            <!-- Toggle Button -->
            <Button x:Name="BtnTogglePanel" Content="⚙️ Settings" Style="{StaticResource ModernButton}" Click="BtnTogglePanel_Click" HorizontalAlignment="Left" Margin="0,0,0,10" Padding="10,6" FontSize="13"/>
            
            <!-- Control Panel -->
            <Border x:Name="ControlPanel" Background="#E61A1A1A" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1" MaxWidth="320" MaxHeight="750">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="🌐 Live Translator" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="20" Margin="0,0,0,15"/>
                        
                        <!-- Language Settings -->
                        <TextBlock Text="Bahasa Asal:" Foreground="#BBBBBB" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbSourceLang" SelectedIndex="0" Margin="0,0,0,12" Padding="5">
                            <ComboBoxItem Content="Auto Detect" Tag="auto"/>
                            <ComboBoxItem Content="English (en)" Tag="en"/>
                            <ComboBoxItem Content="Japanese (ja)" Tag="ja"/>
                            <ComboBoxItem Content="Korean (ko)" Tag="ko"/>
                            <ComboBoxItem Content="Chinese (zh)" Tag="zh"/>
                            <ComboBoxItem Content="Indonesia (id)" Tag="id"/>
                            <ComboBoxItem Content="Spanish (es)" Tag="es"/>
                            <ComboBoxItem Content="French (fr)" Tag="fr"/>
                            <ComboBoxItem Content="German (de)" Tag="de"/>
                            <ComboBoxItem Content="Russian (ru)" Tag="ru"/>
                            <ComboBoxItem Content="Arabic (ar)" Tag="ar"/>
                        </ComboBox>

                        <TextBlock Text="Bahasa Tujuan:" Foreground="#BBBBBB" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbTargetLang" SelectedIndex="0" Margin="0,0,0,15" Padding="5">
                            <ComboBoxItem Content="Indonesia (id)" Tag="id"/>
                            <ComboBoxItem Content="English (en)" Tag="en"/>
                            <ComboBoxItem Content="Japanese (ja)" Tag="ja"/>
                            <ComboBoxItem Content="Korean (ko)" Tag="ko"/>
                            <ComboBoxItem Content="Chinese Simplified (zh)" Tag="zh"/>
                            <ComboBoxItem Content="Spanish (es)" Tag="es"/>
                            <ComboBoxItem Content="French (fr)" Tag="fr"/>
                            <ComboBoxItem Content="German (de)" Tag="de"/>
                            <ComboBoxItem Content="Russian (ru)" Tag="ru"/>
                            <ComboBoxItem Content="Arabic (ar)" Tag="ar"/>
                        </ComboBox>

                        <!-- Engine Settings -->
                        <TextBlock Text="Engine Translate:" Foreground="#BBBBBB" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbEngine" SelectedIndex="1" Margin="0,0,0,8" Padding="5" SelectionChanged="CmbEngine_SelectionChanged">
                            <ComboBoxItem Content="Google Free (Slow, Free)" Tag="google"/>
                            <ComboBoxItem Content="Groq AI (Fast, Smart)" Tag="groq"/>
                        </ComboBox>
                        
                        <TextBlock Text="API Key (Groq/DeepL):" Foreground="#BBBBBB" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtApiKey" Margin="0,0,0,8" Padding="5" Background="#2A2A2A" Foreground="White" BorderBrush="#555"/>
                        
                        <TextBlock Text="Model Groq:" Foreground="#BBBBBB" FontSize="11" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbGroqModel" Grid.Column="0" IsEditable="True" MaxDropDownHeight="150" Padding="5">
                                <ComboBoxItem Content="(Otomatis)" Tag="" IsSelected="True"/>
                            </ComboBox>
                            <Button Grid.Column="1" Content="↻" Width="30" Margin="5,0,0,0" ToolTip="Refresh model list" Click="BtnRefreshModels_Click" Style="{StaticResource ModernButton}" Padding="0"/>
                        </Grid>

                        <Separator Margin="0,5,0,15" Background="#333"/>

                        <!-- Screen OCR Section -->
                        <TextBlock Text="📷 Screen OCR" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="15" Margin="0,0,0,10"/>
                        <Button x:Name="BtnDrawArea" Content="✂️ Pilih Area Layar" Click="BtnDrawArea_Click" Style="{StaticResource ModernButton}" Margin="0,0,0,8"/>
                        <Button x:Name="BtnStartLive" Content="▶ Mulai Live OCR" Click="BtnStartLive_Click" Style="{StaticResource ActionPrimaryButton}" Margin="0,0,0,15" IsEnabled="False"/>
                        
                        <Separator Margin="0,5,0,15" Background="#333"/>

                        <!-- Audio STT Section -->
                        <TextBlock Text="🎙 Audio Transcription" Foreground="White" FontFamily="Segoe UI Semibold" FontSize="15" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtAudioStatus" Text="Model belum dimuat" Foreground="#888" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        <Button x:Name="BtnStartAudio" Content="🔊 Mulai Audio Translate" Click="BtnStartAudio_Click" Style="{StaticResource ActionPrimaryButton}" Margin="0,0,0,20"/>

                        <Separator Margin="0,5,0,15" Background="#333"/>
                        
                        <!-- Extras -->
                        <Button Content="📝 Buka Notepad History" Click="BtnOpenHistory_Click" Style="{StaticResource ModernButton}" Margin="0,0,0,8"/>
                        <Button Content="✕ Tutup App" Click="CloseButton_Click" Style="{StaticResource ActionDangerButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Canvas>
</Window>
