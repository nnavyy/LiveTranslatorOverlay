<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Core/Translation/*.cs" Link="Translation/%(Filename)%(Extension)" />
    <Compile Include="../Core/Localization/*.cs" Link="Localization/%(Filename)%(Extension)" />
    <Compile Include="../Core/Japanese/JapaneseScriptConverter.cs" Link="Japanese/JapaneseScriptConverter.cs" />
    <Compile Include="../Core/HallucinationDetector.cs" Link="HallucinationDetector.cs" />
    <Compile Include="../Core/LocalSpeechService.cs" Link="LocalSpeechService.cs" />
    <Compile Include="../Core/SpeechModelDownload.cs" Link="SpeechModelDownload.cs" />
    <Compile Include="../Core/WhisperSttService.cs" Link="WhisperSttService.cs" />
    <Compile Include="../Core/QuotaTracker.cs" Link="QuotaTracker.cs" />
    <Compile Include="../Core/AppSettings.cs" Link="AppSettings.cs" />
    <Compile Include="../Core/Feedback/*.cs" Link="Feedback/%(Filename)%(Extension)" />
    <Compile Include="../Core/Update/AppVersion.cs" Link="Update/AppVersion.cs" />
    <Compile Include="../Core/Update/StableRelease.cs" Link="Update/StableRelease.cs" />
    <Compile Include="../Core/Update/ReleaseNotes.cs" Link="Update/ReleaseNotes.cs" />
    <Compile Include="TranslationHistory.cs" />
    <Compile Include="TermsNotice.cs" />
    <Compile Include="GuestAudioUsage.cs" />
    <EmbeddedResource Include="../APP_LICENSE.md" LogicalName="APP_LICENSE.md" />
    <EmbeddedResource Include="../PRIVACY.md" LogicalName="PRIVACY.md" />
    <EmbeddedResource Include="../TERMS_REVISION.txt" LogicalName="TERMS_REVISION.txt" />
    <EmbeddedResource Include="../Core/Localization/es.json" LogicalName="LiveTranslatorOverlay.Core.Localization.es.json" />
  </ItemGroup>
</Project>
