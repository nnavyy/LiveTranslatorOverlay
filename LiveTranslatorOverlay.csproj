<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>2.1.2</Version>
    <AssemblyVersion>2.1.2.0</AssemblyVersion>
    <FileVersion>2.1.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Shared\LiveTranslatorOverlay.Shared.csproj" />
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

  <!-- Exclude sub-projects from main project compilation -->
  <ItemGroup>
    <Compile Remove="AudioDiag\**" />
    <Compile Remove="tests\**" />
    <Compile Remove="Shared\**;MacApp\**;Core\Translation\**;Core\Localization\**;Core\Feedback\**;Core\Japanese\JapaneseScriptConverter.cs;Core\AppSettings.cs;Core\QuotaTracker.cs;Core\HallucinationDetector.cs;Core\Update\AppVersion.cs;Core\Update\ReleaseNotes.cs" />
    <None Include="AudioDiag\**" />
    <None Update="appsettings.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="runtime\speech_worker.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="runtime\translation_worker.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="licenses\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="APP_LICENSE.md;PRIVACY.md;THIRD_PARTY_NOTICES.md;LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
