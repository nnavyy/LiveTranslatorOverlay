<Window x:Class="LiveTranslatorOverlay.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔴 Live Transcript &amp; Translator" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBox x:Name="TxtHistory" Grid.Row="0" 
                 TextWrapping="Wrap" AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto" 
                 Margin="10" FontFamily="Consolas" FontSize="14" IsReadOnly="True" />
                 
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="✨ AI Rangkum (Meeting Notes)" Background="#8A2BE2" Foreground="White" Padding="10,0" FontWeight="Bold" Margin="0,0,10,0" Click="BtnSummarize_Click"/>
            <Button Content="Clear" Width="80" Margin="0,0,10,0" Click="BtnClear_Click"/>
            <Button Content="Save to File" Width="100" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
