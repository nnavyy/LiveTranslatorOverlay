<Window x:Class="LiveTranslatorOverlay.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Transcript &amp; Translator" Height="520" Width="460"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#121217" Foreground="#F2F2F7"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style TargetType="Button" x:Key="HistoryActionButton">
            <Setter Property="Background" Value="#24242D"/>
            <Setter Property="Foreground" Value="#F2F2F7"/>
            <Setter Property="BorderBrush" Value="#363645"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#32323E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="HistoryPrimaryButton" BasedOn="{StaticResource HistoryActionButton}">
            <Setter Property="Background" Value="#0A84FF"/>
            <Setter Property="BorderBrush" Value="#3B9CFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2492FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBox x:Name="TxtHistory" Grid.Row="0" 
                 TextWrapping="Wrap" AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"
                 Background="#18181F" Foreground="#F2F2F7"
                 BorderBrush="#2C2C38" BorderThickness="1"
                 Padding="12" FontFamily="Consolas, Segoe UI Variable Text" FontSize="13.5" IsReadOnly="True" />

        <Button x:Name="BtnJumpLatest" Grid.Row="0" Content="&#x2193;" Width="30" Height="30" Padding="0"
                Style="{StaticResource HistoryActionButton}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16" Visibility="Collapsed"
                ToolTip="Jump to latest" AutomationProperties.Name="Jump to latest" Click="BtnJumpLatest_Click"/>
                 
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnSummarize" Content="AI Summary" Style="{StaticResource HistoryActionButton}" Margin="0,0,8,0" Click="BtnSummarize_Click"/>
            <Button x:Name="BtnClear" Content="Clear" MinWidth="76" Style="{StaticResource HistoryActionButton}" Margin="0,0,8,0" Click="BtnClear_Click"/>
            <Button x:Name="BtnSave" Content="Save to File" MinWidth="96" Style="{StaticResource HistoryPrimaryButton}" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
