  "translations": [
    {
      "SourceLanguage": "en",
      "TargetLanguage": "id",
      "ElapsedMs": 5683.5,
      "IsColdStart": true,
      "SourceText": "However, due to the slow communication channels, styles in the West could lag behind by 25-30 years.",
      "TranslatedText": "Namun, karena saluran komunikasi yang lambat, gaya di Barat bisa tertinggal 25-30 tahun."
    },
    {
      "SourceLanguage": "en",
      "TargetLanguage": "id",
      "ElapsedMs": 249.5,
      "IsColdStart": false,
      "SourceText": "All nouns alongside the words say for you always begin with a capital letter even in the middle of a sentence.",
      "TranslatedText": "Semua nota di samping kata-kata mengatakan bahwa Anda selalu memulai dengan huruf utama bahkan di tengah-tengah kalimat."
    },
    {
      "SourceLanguage": "en",
      "TargetLanguage": "id",
      "ElapsedMs": 776.8,
      "IsColdStart": false,
      "SourceText": "To the north and within easy reach is the romantic and fascinating town of Cintra and which was made famous to foreigners after a glowing account of its splendor as recorded by Lord Byron.",
      "TranslatedText": "Ke utara dan di dalam jangkauan mudah adalah kota romantis dan menarik Cintra dan yang telah menjadi terkenal bagi orang asing setelah sebuah cerita yang menakjubkan tentang keindahan seperti yang dicatatkan oleh Lord Byron."
    },
    {
      "SourceLanguage": "id",
      "TargetLanguage": "en",
      "ElapsedMs": 354.2,
      "IsColdStart": false,
      "SourceText": "Tim-tim virtual memiliki standar keunggulan yang sama dengan tim konvensional, tetapi ada sedikit perbedaan.",
      "TranslatedText": "Virtual teams have the same standard of excellence as conventional teams, but there is a little difference."
    },
    {
      "SourceLanguage": "id",
      "TargetLanguage": "en",
      "ElapsedMs": 454.2,
      "IsColdStart": false,
      "SourceText": "Segera setelah permusuhan pecah, Britania memulai blokade Laut Cerman.",
      "TranslatedText": "Immediately after the enemy broke out, Britain began the blockade of the Sea of Cerman."
    },
    {
      "SourceLanguage": "id",
      "TargetLanguage": "en",
      "ElapsedMs": 297.8,
      "IsColdStart": false,
      "SourceText": "Semua nomina di samping kata si untuk Anda selalu dimulai dengan hukum kapital bahkan di tengah kalimat.",
      "TranslatedText": "All nominations in addition to the word si for you always begin with the capital law even in the middle of the sentence."
    },
